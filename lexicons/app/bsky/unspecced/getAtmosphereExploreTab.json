{
  "lexicon": 1,
  "id": "app.bsky.unspecced.getAtmosphereExploreTab",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get Atmosphere Explore content. Articles and photo galleries are recommended when their algorithmic recommendations are enabled for the request, and curated otherwise; other sections are curated. Curated content is selected using the x-atproto-bsky-geo-country, x-atproto-bsky-geo-region, and x-atproto-bsky-topics request headers. Authentication is optional; authenticated requests include viewer-specific profile state.",
      "parameters": {
        "type": "params",
        "properties": {
          "langs": {
            "type": "array",
            "description": "Preferred languages for article and photo gallery recommendations when their algorithmic recommendations are enabled. Ignored otherwise.",
            "items": { "type": "string", "format": "language" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "articles",
            "publications",
            "photos",
            "livestreams",
            "apps"
          ],
          "properties": {
            "announcementBanner": {
              "type": "ref",
              "ref": "#announcementBanner"
            },
            "articles": { "type": "ref", "ref": "#articleList" },
            "publications": { "type": "ref", "ref": "#publicationList" },
            "photos": { "type": "ref", "ref": "#galleryList" },
            "livestreams": { "type": "ref", "ref": "#livestreamList" },
            "apps": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "ref", "ref": "#appCard" }
            }
          }
        }
      }
    },
    "articleList": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#articleItem" }
        },
        "recIdStr": {
          "type": "string",
          "description": "Snowflake for this list's recommendation, use when submitting recommendation events. Omitted when the list is not algorithmically recommended."
        }
      }
    },
    "publicationList": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#publicationItem" }
        },
        "recIdStr": {
          "type": "string",
          "description": "Snowflake for this list's recommendation, use when submitting recommendation events. Omitted when the list is not algorithmically recommended."
        }
      }
    },
    "galleryList": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#galleryItem" }
        },
        "recIdStr": {
          "type": "string",
          "description": "Snowflake for this list's recommendation, use when submitting recommendation events. Omitted when the list is not algorithmically recommended."
        }
      }
    },
    "livestreamList": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#livestreamItem" }
        },
        "recIdStr": {
          "type": "string",
          "description": "Snowflake for this list's recommendation, use when submitting recommendation events. Omitted when the list is not algorithmically recommended."
        }
      }
    },
    "articleItem": {
      "type": "object",
      "required": ["featured", "view"],
      "properties": {
        "featured": {
          "type": "boolean",
          "description": "Deprecated. Retained for compatibility; always false."
        },
        "bskyPostRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef",
          "description": "The Bluesky post associated with the article, as declared by its author. The referenced post may not be available."
        },
        "viewBskyPost": {
          "type": "ref",
          "ref": "app.bsky.feed.defs#postView",
          "description": "The hydrated Bluesky post associated with the article, as declared by its author. Omitted when the post is unavailable to the viewer."
        },
        "view": { "type": "ref", "ref": "app.bsky.embed.external#viewArticle" }
      }
    },
    "publicationItem": {
      "type": "object",
      "required": ["featured", "view"],
      "properties": {
        "featured": {
          "type": "boolean",
          "description": "Deprecated. Retained for compatibility; always false."
        },
        "view": {
          "type": "ref",
          "ref": "app.bsky.embed.external#viewArticlePublication"
        }
      }
    },
    "galleryItem": {
      "type": "object",
      "required": ["featured", "view"],
      "properties": {
        "featured": {
          "type": "boolean",
          "description": "Deprecated. Retained for compatibility; always false."
        },
        "view": { "type": "ref", "ref": "app.bsky.embed.external#viewGallery" }
      }
    },
    "livestreamItem": {
      "type": "object",
      "required": ["featured", "view"],
      "properties": {
        "featured": {
          "type": "boolean",
          "description": "Deprecated. Retained for compatibility; always false."
        },
        "bskyPostRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef",
          "description": "The Bluesky post that announced the livestream, as declared by its author. The referenced post may not be available."
        },
        "viewBskyPost": {
          "type": "ref",
          "ref": "app.bsky.feed.defs#postView",
          "description": "The hydrated Bluesky post that announced the livestream, as declared by its author. Omitted when the post is unavailable to the viewer."
        },
        "view": {
          "type": "ref",
          "ref": "app.bsky.embed.external#viewLivestream"
        }
      }
    },
    "announcementBanner": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 4096 },
        "title": { "type": "string", "maxLength": 4096 },
        "description": { "type": "string", "maxLength": 4096 },
        "url": { "type": "string", "format": "uri", "maxLength": 4096 },
        "image": { "type": "string", "format": "uri", "maxLength": 4096 },
        "overlayColor": { "type": "string", "maxLength": 4096 },
        "textColor": { "type": "string", "maxLength": 4096 }
      }
    },
    "appCard": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 4096 },
        "title": { "type": "string", "maxLength": 4096 },
        "description": { "type": "string", "maxLength": 4096 },
        "logo": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "The profile avatar when available, otherwise the editorial logo."
        },
        "backgroundImage": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "The profile banner when available, otherwise the editorial background image."
        },
        "overlayColor": {
          "type": "string",
          "maxLength": 4096,
          "description": "Deprecated. Retained for compatibility."
        },
        "textColor": {
          "type": "string",
          "maxLength": 4096,
          "description": "Deprecated. Retained for compatibility."
        },
        "url": { "type": "string", "format": "uri", "maxLength": 4096 },
        "appStoreUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "Optional link to the app on the Apple App Store."
        },
        "googlePlayUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "Optional link to the app on Google Play."
        },
        "category": { "type": "string", "maxLength": 4096 },
        "profile": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewDetailed",
          "description": "The app's optional Bluesky account profile. Omitted when no profile is configured or the profile is unavailable."
        }
      }
    }
  }
}
