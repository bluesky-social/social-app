{
  "lexicon": 1,
  "id": "app.bsky.unspecced.getAtmosphereApps",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get curated Atmosphere apps. Authentication is optional; authenticated requests include viewer-specific profile state and known followers.",
      "parameters": {
        "type": "params",
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 100,
            "description": "Only return apps with this category (exact match). Omit to return all apps."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apps"],
          "properties": {
            "apps": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#appCard"
              }
            }
          }
        }
      }
    },
    "appCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "logo": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "The app's logo, using its account avatar when available."
        },
        "banner": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "The app's banner, using its account banner when available."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        },
        "appStoreUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "Optional link to the app on the Apple App Store."
        },
        "googlePlayUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "description": "Optional link to the app on Google Play."
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "profile": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewDetailed",
          "description": "The app's optional Bluesky account profile. Omitted when no profile is configured or the profile is unavailable."
        }
      }
    }
  }
}
