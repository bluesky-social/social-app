{
  "lexicon": 1,
  "id": "app.bsky.unspecced.getAtmosphereRecommendedActivity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get recommended Standard.site articles and Grain galleries for Atmosphere Activity in recommendation order. Authentication is optional. Unavailable items are omitted, so the response may contain fewer than the requested limit.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "langs": {
            "type": "array",
            "description": "Preferred languages for article recommendations. Overrides the Accept-Language header when nonempty.",
            "items": {"type": "string", "format": "language"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "recIdStr"],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {"type": "ref", "ref": "#item"}
            },
            "recIdStr": {
              "type": "string",
              "description": "Snowflake for this recommendation, use when submitting recommendation events."
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["view"],
      "properties": {
        "view": {
          "type": "union",
          "refs": [
            "app.bsky.embed.external#viewArticle",
            "app.bsky.embed.external#viewGallery"
          ]
        }
      }
    }
  }
}
