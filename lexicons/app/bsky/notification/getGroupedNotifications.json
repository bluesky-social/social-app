{
  "id": "app.bsky.notification.getGroupedNotifications",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "groups"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 1024
            },
            "groups": {
              "type": "array",
              "items": {
                "ref": "#group",
                "type": "ref"
              },
              "description": "Notification groups or individual notifications, newest first. Clients should ignore kinds they do not recognize. Grouping behavior depends on the kind and selected feed."
            },
            "seenAt": {
              "type": "string",
              "format": "datetime"
            },
            "relatedViews": {
              "type": "array",
              "items": {
                "refs": [
                  "app.bsky.actor.defs#profileViewDetailed",
                  "app.bsky.feed.defs#blockedPost",
                  "app.bsky.feed.defs#generatorView",
                  "app.bsky.feed.defs#notFoundPost",
                  "app.bsky.feed.defs#postView",
                  "app.bsky.graph.defs#starterPackView"
                ],
                "type": "union"
              },
              "description": "Reusable views referenced by notifications. Views shared across notifications appear once to avoid duplication. Each group contributes only its first 10 of each related view to this array. Ex: for a group containing likes in a post, we might have a large number of likeItem (e.g., 50) in a group, but only the profile views for the newest 10 items will be included here."
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "feed": {
            "type": "string",
            "default": "all",
            "maxLength": 32,
            "description": "Which notification feed to return. Grouping behavior varies by feed: notifications about follows might be grouped in 'all' and ungrouped (or rather, in single-item groups) in 'followers'.",
            "knownValues": [
              "all",
              "people-i-follow",
              "conversations",
              "followers",
              "activity"
            ]
          },
          "limit": {
            "type": "integer",
            "default": 30,
            "maximum": 50,
            "minimum": 1,
            "description": "Maximum number of groups to return."
          },
          "cursor": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "description": "[UNSTABLE - DO NOT USE THIS ENDPOINT WHILE THIS NOTE IS HERE] Enumerate notifications for the requesting account, pre-grouped for rendering. Supersedes listNotifications. Requires auth."
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "isRead",
        "indexedAt",
        "count",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "kind": {
          "refs": [
            "#likeGroup",
            "#multiPostLikeGroup",
            "#repostGroup",
            "#likeViaRepostGroup",
            "#repostViaRepostGroup",
            "#followGroup",
            "#subscribedPostGroup",
            "#generatorLikeGroup",
            "#replyNotification",
            "#quoteNotification",
            "#mentionNotification",
            "#followBackNotification",
            "#verifiedNotification",
            "#unverifiedNotification",
            "#starterPackJoinedNotification",
            "#contactMatchNotification"
          ],
          "type": "union"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "isRead": {
          "type": "boolean"
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      },
      "description": "Contains common metadata and kind-specific data for a notification group or individual notification."
    },
    "likeItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One actor who liked the group's post."
    },
    "likeGroup": {
      "type": "object",
      "required": [
        "post",
        "items"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "items": {
          "type": "array",
          "items": {
            "ref": "#likeItem",
            "type": "ref"
          },
          "minLength": 1
        }
      },
      "description": "Group of likes by different actors on the same post."
    },
    "followItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        },
        "starterPack": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "An actor who followed the requesting account, possibly via a starter pack."
    },
    "repostItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One actor who reposted the group's post."
    },
    "followGroup": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "ref": "#followItem",
            "type": "ref"
          },
          "minLength": 1
        }
      },
      "description": "Group of actors who followed the requesting account."
    },
    "repostGroup": {
      "type": "object",
      "required": [
        "post",
        "items"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "items": {
          "type": "array",
          "items": {
            "ref": "#repostItem",
            "type": "ref"
          },
          "minLength": 1
        }
      },
      "description": "Group of reposts by different actors of the same post."
    },
    "generatorLikeItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One actor who liked the feed generator in the group."
    },
    "likeViaRepostItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One actor who liked the group's post via the requesting account's repost."
    },
    "multiPostLikeItem": {
      "type": "object",
      "required": [
        "post"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "One post which was liked by the group's actor."
    },
    "quoteNotification": {
      "type": "object",
      "required": [
        "post"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "parent": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "A post quoting a post by the requesting account."
    },
    "replyNotification": {
      "type": "object",
      "required": [
        "post",
        "parent"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "parent": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "A reply to a post by the requesting account or to a thread they are participating in."
    },
    "generatorLikeGroup": {
      "type": "object",
      "required": [
        "generator",
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "ref": "#generatorLikeItem",
            "type": "ref"
          },
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "Group of likes by different actors on the same feed generator."
    },
    "likeViaRepostGroup": {
      "type": "object",
      "required": [
        "post",
        "viaRepost",
        "items"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "items": {
          "type": "array",
          "items": {
            "ref": "#likeViaRepostItem",
            "type": "ref"
          },
          "minLength": 1
        },
        "viaRepost": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "Group of likes by different actors on the same post via the requesting account's repost."
    },
    "multiPostLikeGroup": {
      "type": "object",
      "required": [
        "actor",
        "items"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        },
        "items": {
          "type": "array",
          "items": {
            "ref": "#multiPostLikeItem",
            "type": "ref"
          },
          "minLength": 2
        }
      },
      "description": "Group of likes by the same actor on different posts."
    },
    "subscribedPostItem": {
      "type": "object",
      "required": [
        "actor",
        "post"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One new post by an actor the requesting account subscribes to."
    },
    "mentionNotification": {
      "type": "object",
      "required": [
        "post"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "parent": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "A post mentioning the requesting account."
    },
    "repostViaRepostItem": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "One actor who reposted the group's post via the requesting account's repost."
    },
    "subscribedPostGroup": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "ref": "#subscribedPostItem",
            "type": "ref"
          },
          "minLength": 1
        }
      },
      "description": "Group of new posts by actors the requesting account subscribes to."
    },
    "repostViaRepostGroup": {
      "type": "object",
      "required": [
        "post",
        "viaRepost",
        "items"
      ],
      "properties": {
        "post": {
          "type": "string",
          "format": "at-uri"
        },
        "items": {
          "type": "array",
          "items": {
            "ref": "#repostViaRepostItem",
            "type": "ref"
          },
          "minLength": 1
        },
        "viaRepost": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "Group of reposts by different actors of the same post via the requesting account's repost."
    },
    "verifiedNotification": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "An actor verified the requesting account."
    },
    "followBackNotification": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        },
        "starterPack": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "An actor followed the requesting account back, possibly via a starter pack."
    },
    "unverifiedNotification": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "A verification of the requesting account was removed."
    },
    "contactMatchNotification": {
      "type": "object",
      "required": [
        "actor"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "A contact of the requesting account joined Bluesky."
    },
    "starterPackJoinedNotification": {
      "type": "object",
      "required": [
        "actor",
        "starterPack"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did"
        },
        "starterPack": {
          "type": "string",
          "format": "at-uri"
        }
      },
      "description": "An actor joined Bluesky via a starter pack created by the requesting account."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
