{
  "id": "social.grain.photo",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "photo",
          "aspectRatio",
          "createdAt"
        ],
        "properties": {
          "alt": {
            "type": "string",
            "description": "Alt text description of the image, for accessibility."
          },
          "photo": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "aspectRatio": {
            "ref": "social.grain.defs#aspectRatio",
            "type": "ref"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
