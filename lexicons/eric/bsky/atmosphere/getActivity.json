{
  "lexicon": 1,
  "id": "eric.bsky.atmosphere.getActivity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns recent activity for a tracked viewer.",
      "parameters": {
        "type": "params",
        "properties": {
          "viewer": { "type": "string", "format": "did" },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed", "associatedRecords", "actors"],
          "properties": {
            "feed": {
              "type": "array",
              "items": { "type": "ref", "ref": "#activityItem" }
            },
            "associatedRecords": {
              "type": "unknown",
              "description": "A map of AT URI to locally resolved associated record."
            },
            "actors": {
              "type": "unknown",
              "description": "A map of actor DID to app.bsky.actor.defs#profileViewBasic."
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "activityItem": {
      "type": "object",
      "required": ["record", "viewerState"],
      "properties": {
        "record": { "type": "ref", "ref": "#activityRecord" },
        "viewerState": { "type": "ref", "ref": "#viewerState" }
      }
    },
    "activityRecord": {
      "type": "object",
      "required": ["uri", "cid", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "viewerState": {
      "type": "object",
      "required": ["subscribed"],
      "properties": {
        "subscribed": {
          "type": "boolean",
          "description": "Whether the viewer currently subscribes to this document's publication. False for non-document activity."
        }
      }
    }
  }
}
