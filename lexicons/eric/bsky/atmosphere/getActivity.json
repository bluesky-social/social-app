{
  "lexicon": 1,
  "id": "eric.bsky.atmosphere.getActivity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns recent activity for the authenticated tracked viewer.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed", "associatedRecords", "actors"],
          "properties": {
            "feed": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": ["#item", "#group"]
              }
            },
            "associatedRecords": {
              "type": "unknown",
              "description": "A map of AT URI to locally resolved associated record."
            },
            "actors": {
              "type": "unknown",
              "description": "A map of actor DID to app.bsky.actor.defs#profileViewBasic."
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["record", "collection", "viewerState"],
      "properties": {
        "record": { "type": "ref", "ref": "#activityRecord" },
        "collection": {
          "type": "string",
          "format": "nsid",
          "description": "The root record's collection NSID."
        },
        "viewerState": { "type": "ref", "ref": "#viewerState" },
        "relatedActivity": {
          "type": "array",
          "minLength": 1,
          "items": { "type": "ref", "ref": "#item" },
          "description": "Page-local recommendation activity targeting this document. Children are reverse chronological and do not contain related activity."
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "groupBy", "collection", "indexedAt", "items"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Opaque deterministic identifier for this grouping result."
        },
        "groupBy": {
          "type": "string",
          "knownValues": ["subject", "actor"],
          "description": "The grouping dimension used for this entry."
        },
        "collection": {
          "type": "string",
          "format": "nsid",
          "description": "The root-record collection shared by every child."
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "The activity event time of the newest child."
        },
        "subject": {
          "type": "string",
          "format": "at-uri",
          "description": "The shared interaction target for a subject group."
        },
        "actor": {
          "type": "string",
          "format": "did",
          "description": "The shared author for an actor group."
        },
        "items": {
          "type": "array",
          "minLength": 2,
          "items": { "type": "ref", "ref": "#item" },
          "description": "Reverse-chronological child items; groups are never nested."
        }
      }
    },
    "activityRecord": {
      "type": "object",
      "required": ["uri", "cid", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "viewerState": {
      "type": "object",
      "required": ["subscribed"],
      "properties": {
        "subscribed": {
          "type": "boolean",
          "description": "Whether the viewer currently subscribes to this document's publication. False for non-document activity."
        }
      }
    }
  }
}
