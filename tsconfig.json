{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "lib": ["dom", "esnext"],
    "types": ["node", "jest"],
    "paths": {
      "#/*": ["./src/*"],
      "crypto": ["./src/platform/crypto.ts"],
      /*
       * expo-file-system (since 57) and expo-image-manipulator (since 58) ship
       * an `exports` map without `./build/*`, which blocks the deep type
       * imports in src/platform/misc.web-check.d.ts under
       * `moduleResolution: "bundler"`. Type-check-only escape hatch.
       */
      "expo-file-system/build/*": ["./node_modules/expo-file-system/build/*"],
      "expo-image-manipulator/build/*": [
        "./node_modules/expo-image-manipulator/build/*"
      ],
    },
    "plugins": [
      {
        "name": "ts-plugin-sort-import-suggestions",
        "moveUpPatterns": ["#/", "@lingui/react/macro"],
        "moveDownPatterns": ["react-native-reanimated/lib"],
      }
    ],
    /*
     * The base config sets `["react-native"]`, which resolves some packages
     * (e.g. react-native-view-shot) to TS sources that don't typecheck
     * against React Native 0.88.
     */
    "customConditions": []
  },
  "exclude": ["bskyweb", "bskyembed", "web-build", "dist"]
}
