+                Build.VERSION.SDK_INT == Build.VERSION_CODES.O_MR1 &&
+                    !child.isAttachedToWindow &&
+                    topFrame?.className == View::class.java.name &&
+                    topFrame.methodName == "applyLegacyAnimation"
+
