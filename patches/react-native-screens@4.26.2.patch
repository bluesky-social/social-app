+void RNSScreenShadowNode::setSizeIfChanged(Size size) const {
+  const auto &style = yogaNode_.style();
+  if (style.dimension(yoga::Dimension::Width) ==
+          yoga::StyleSizeLength::points(size.width) &&
+      style.dimension(yoga::Dimension::Height) ==
+          yoga::StyleSizeLength::points(size.height)) {
+    return;
+  }
+  setSize(size);
+}
