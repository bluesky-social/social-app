+ * the UI runtime as a shareable holding the shadow node wrapper in `.value`,
+ * not as a callable function, so `ref()` throws "Object is not a function".
+ * On web the ref is still a plain function.
+ *
+ * @param ref - Animated ref captured by the worklet.
+ * @returns Whether the ref currently points to a view.
+ * @example
+ * ```ts
+ * if (!isAnimatedRefAttached(scrollViewRef)) return;
+ * ```
+ */
+export const isAnimatedRefAttached = (
+  ref: AnimatedRef<Reanimated.ScrollView>,
+): boolean => {
+  "worklet";
+
+  if (typeof ref === "function") {
+    return ref() != null;
+  }
+
+  return (ref as unknown as { value: unknown }).value != null;
+};
