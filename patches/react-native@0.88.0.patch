+    while (order_.size() > maxKeys_) {
+      // A taken key stays in order_, so this can drop a newer layout for the
+      // same text. That text then just takes the default path.
+      layouts_.erase(order_.front());
+      order_.pop_front();
+    }
+  }
+
+  /*
+   * Removes and returns the newest layout for `key` that satisfies `matches`.
+   */
+  NSTextStorage *_Nullable take(const RCTTextLayoutKey &key, const std::function<bool(CGSize)> &matches)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = layouts_.find(key);
+    if (it == layouts_.end()) {
+      return nil;
+    }
