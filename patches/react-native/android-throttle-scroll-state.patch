+    // Race an UpdateState with onScroll. This makes it more likely that, in Fabric, when JS
+    // processes the scroll event, the C++ ShadowNode representation will have a "more correct"
+    // scroll position. Each update commits the shadow tree, so while scrolling send at most one
+    // per SCROLL_STATE_UPDATE_INTERVAL_MS, plus a trailing update so the final position is never
+    // stale (touch up and the end of a fling also update it).
+    val now = SystemClock.uptimeMillis()
+    val elapsed = now - (lastScrollStateUpdateTimes[scrollView] ?: 0L)
+    if (elapsed >= SCROLL_STATE_UPDATE_INTERVAL_MS) {
+      pendingScrollStateUpdates.remove(scrollView)?.let { scrollView.removeCallbacks(it) }
+      lastScrollStateUpdateTimes[scrollView] = now
+      updateFabricScrollState(scrollView, scrollView.scrollX, scrollView.scrollY)
+    } else if (!pendingScrollStateUpdates.containsKey(scrollView)) {
+      val update = Runnable {
+        pendingScrollStateUpdates.remove(scrollView)
+        lastScrollStateUpdateTimes[scrollView] = SystemClock.uptimeMillis()
+        updateFabricScrollState(scrollView, scrollView.scrollX, scrollView.scrollY)
+      }
+      pendingScrollStateUpdates[scrollView] = update
+      scrollView.postDelayed(update, SCROLL_STATE_UPDATE_INTERVAL_MS - elapsed)
