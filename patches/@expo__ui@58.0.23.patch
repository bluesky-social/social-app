+/**
+ * The Material 3 Expressive menu: a popup with one rounded group, whose items are shaped by their
+ * position in it. `color`, `cornerRadius` and `shadowElevation` don't apply.
+ */
+@Composable
+private fun FunctionalComposableScope.ExpressiveMenu(
+  props: DropdownMenuProps,
+  itemsView: ExpoComposeView<*>,
+  onDismissRequest: () -> Unit
+) {
+  DropdownMenuPopup(
+    expanded = props.expanded,
+    onDismissRequest = onDismissRequest,
+    // Padded on both sides, so the gap faces the trigger whichever way the menu opens.
+    modifier = Modifier.padding(vertical = (props.anchorGap ?: 0f).dp),
+    properties = PopupProperties(
+      focusable = props.properties.focusable,
+      dismissOnBackPress = props.properties.dismissOnBackPress,
+      dismissOnClickOutside = props.properties.dismissOnClickOutside,
+      clippingEnabled = props.properties.clippingEnabled
+    )
+  ) {
+    DropdownMenuGroup(shapes = MenuDefaults.groupShapes()) {
+      val scope = UIComposableScope(columnScope = this)
+      val indices = (0..<itemsView.size).filter {
+        (itemsView.getChildAt(it) as? ExpoComposeView<*>)?.shouldUseAndroidLayout == false
+      }
+      if (indices.isEmpty()) {
+        // Renders nothing, but subscribes to items being added.
+        itemsView.Children(scope)
+      }
+      indices.forEachIndexed { i, childIndex ->
+        CompositionLocalProvider(LocalMenuItemPosition provides MenuItemPosition(i, indices.size)) {
+          itemsView.Child(scope, childIndex)
+        }
+      }
+    }
+  }
+}
