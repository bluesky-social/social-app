+package expo.modules.ui.menu
+
+import android.view.ViewGroup
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.DropdownMenuGroup
+import androidx.compose.material3.HorizontalDivider
+import androidx.compose.material3.MenuDefaults
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.ProvidableCompositionLocal
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.ui.Modifier
+import androidx.core.view.size
+import expo.modules.kotlin.views.ComposableScope
+import expo.modules.kotlin.views.ComposeProps
+import expo.modules.kotlin.views.ExpoComposeView
+import expo.modules.kotlin.views.FunctionalComposableScope
+import expo.modules.kotlin.views.OptimizedComposeProps
+import expo.modules.ui.ModifierList
+import expo.modules.ui.ModifierRegistry
+import expo.modules.ui.UIComposableScope
+
+/**
+ * A child's position among its siblings, which picks its Material 3 Expressive shape:
+ * rounder outer corners for the first and last.
+ */
+internal data class MenuPosition(val index: Int, val count: Int)
+
+/** The position of a group in a grouped menu. */
+internal val LocalMenuGroupPosition = compositionLocalOf<MenuPosition?> { null }
+
+/** The position of an item in its group. Items outside a group are standard menu items. */
+internal val LocalMenuItemPosition = compositionLocalOf<MenuPosition?> { null }
+
+@OptimizedComposeProps
+data class DropdownMenuGroupProps(
+  val label: String? = null,
+  val modifiers: ModifierList = emptyList()
+) : ComposeProps
+
+/** Whether the menu's items are groups, which makes it a grouped Material 3 Expressive menu. */
+internal fun hasMenuGroups(itemsView: ViewGroup): Boolean {
+  return (0..<itemsView.size).any {
+    (itemsView.getChildAt(it) as? ExpoComposeView<*>)?.props is DropdownMenuGroupProps
+  }
+}
+
+/**
+ * Renders the children like `Children`, providing each with its position.
+ */
+@Composable
+internal fun ExpoComposeView<*>.ChildrenWithPosition(
+  composableScope: ComposableScope,
+  position: ProvidableCompositionLocal<MenuPosition?>,
+  separator: @Composable () -> Unit = {}
+) {
+  val indices = (0..<size).filter {
+    (getChildAt(it) as? ExpoComposeView<*>)?.shouldUseAndroidLayout == false
+  }
+  if (indices.isEmpty()) {
+    // Renders nothing, but subscribes to children being added.
+    Children(composableScope)
+    return
+  }
+  indices.forEachIndexed { i, childIndex ->
+    if (i > 0) {
+      separator()
+    }
+    CompositionLocalProvider(position provides MenuPosition(i, indices.size)) {
+      Child(composableScope, childIndex)
+    }
+  }
+}
+
+@Composable
+fun FunctionalComposableScope.DropdownMenuGroupContent(props: DropdownMenuGroupProps) {
+  val position = LocalMenuGroupPosition.current ?: MenuPosition(0, 1)
+
+  DropdownMenuGroup(
+    shapes = MenuDefaults.groupShape(position.index, position.count),
+    modifier = ModifierRegistry.applyModifiers(props.modifiers, appContext, composableScope, globalEventDispatcher)
+  ) {
+    props.label?.let { label ->
+      MenuDefaults.DropdownMenuGroupLabel { Text(label) }
+      HorizontalDivider(modifier = Modifier.padding(MenuDefaults.HorizontalDividerPadding))
+    }
+    view.ChildrenWithPosition(UIComposableScope(columnScope = this), LocalMenuItemPosition)
+  }
+}
