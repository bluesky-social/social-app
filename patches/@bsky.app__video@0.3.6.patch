index 0000000000000000000000000000000000000000..b80ee2d4c1cab5e23de321c4b7723c5ee643429a
--- /dev/null
+++ b/android/src/main/res/layout/bluesky_video_player.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- player_layout_id can only be set from XML, so the inline PlayerView is inflated from here. -->
+<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
+  xmlns:app="http://schemas.android.com/apk/res-auto"
+  android:layout_width="match_parent"
+  android:layout_height="match_parent"
+  app:player_layout_id="@layout/bluesky_video_player_content"
+  app:use_controller="false" />
diff --git a/android/src/main/res/layout/bluesky_video_player_content.xml b/android/src/main/res/layout/bluesky_video_player_content.xml
new file mode 100644
index 0000000000000000000000000000000000000000..758969eb73bd10e29635ce8e4636bb7d556f4767
