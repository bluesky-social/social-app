--- /dev/null
+++ b/src/compile/index.web.ts
@@ -0,0 +1,22 @@
+import {StyleSheet} from 'react-native'
+
+/**
+ * Passes every style object in `styles` through `StyleSheet.create`, so that
+ * react-native-web compiles it once into atomic CSS classes. Without this, RNW
+ * resolves plain objects into inline styles on every render.
+ *
+ * `StyleSheet.create` on web returns the same objects and keeps the compiled
+ * classes in a side table keyed by object identity, so values stay readable
+ * (e.g. `atoms.text_md.fontSize`) and nothing else changes for callers.
+ * Arrays and platform-gated `undefined` entries are skipped.
+ */
+export function compile<T extends object>(styles: T): T {
+  const objects: Record<string, object> = {}
+  for (const [key, value] of Object.entries(styles)) {
+    if (value && typeof value === 'object' && !Array.isArray(value)) {
+      objects[key] = value
+    }
+  }
+  StyleSheet.create(objects)
+  return styles
+}
