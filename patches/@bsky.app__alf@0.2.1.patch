@@ -0,0 +1,152 @@
+import {type HoverStyle, type PseudoStyle} from './types'
+
+export type {HoverStyle, PseudoStyle} from './types'
+
+/**
+ * Bundlers that support react-native-web define this, since RNW reads it too.
+ */
+declare const process: {env: {NODE_ENV?: string}}
+
+const SUPPORTED_PROPS: ReadonlySet<string> = new Set<keyof HoverStyle>([
+  'backgroundColor',
+  'borderColor',
+  'borderTopColor',
+  'borderRightColor',
+  'borderBottomColor',
+  'borderLeftColor',
+  'color',
+  'opacity',
+  'textDecorationColor',
+  'textDecorationLine',
+  'textDecorationStyle',
+])
+
+const SHEET_ID = 'alf-pseudo-stylesheet'
+const IS_DEV = process.env.NODE_ENV !== 'production'
+
+/**
+ * Class name for each `prop:value` declaration, so each one gets one rule no
+ * matter how many hover() calls use it.
+ */
+const classNames = new Map<string, string>()
+/**
+ * Declaration for each class name, to detect hash collisions.
+ */
+const declarations = new Map<string, string>()
+/**
+ * hover() results for stable style objects, e.g. atoms.
+ */
+const compiledStyles = new WeakMap<object, PseudoStyle>()
+let sheet: CSSStyleSheet | null = null
+
+function getSheet() {
+  if (sheet || typeof document === 'undefined') return sheet
+  let element = document.getElementById(SHEET_ID) as HTMLStyleElement | null
+  if (!element) {
+    element = document.createElement('style')
+    element.id = SHEET_ID
+    // After RNW's sheet (which goes first in <head>) and app CSS
+    document.head.appendChild(element)
+  }
+  sheet = element.sheet
+  return sheet
+}
+
+/**
+ * FNV-1a, base 36.
+ */
+function hash(value: string) {
+  let h = 0x811c9dc5
+  for (let i = 0; i < value.length; i++) {
+    h ^= value.charCodeAt(i)
+    h = Math.imul(h, 0x01000193)
+  }
+  return (h >>> 0).toString(36)
+}
+
+function hyphenate(prop: string) {
+  return prop.replace(/[A-Z]/g, char => `-${char.toLowerCase()}`)
+}
+
+function getClassName(prop: string, value: string | number) {
+  const declaration = `${prop}:${value}`
+  let className = classNames.get(declaration)
+  if (className) return className
+
+  const base = IS_DEV
+    ? `alf-hover-${prop}-${hash(declaration)}`
+    : `alf-h-${hash(declaration)}`
+  className = base
+  for (let i = 1; declarations.has(className); i++) {
+    className = `${base}-${i}`
+  }
+  classNames.set(declaration, className)
+  declarations.set(className, declaration)
+
+  /*
+   * `(hover: hover)` keeps touch devices from getting stuck in the hover state
+   * after a tap. The `:hover` selector (0,2,0) beats RNW's atomic classes
+   * (0,1,0), so it doesn't depend on stylesheet order.
+   */
+  getSheet()?.insertRule(
+    `@media (hover: hover) { .${className}:hover { ${hyphenate(prop)}: ${value}; } }`,
+    sheet!.cssRules.length,
+  )
+  return className
+}
+
+/**
+ * Applies `style` while a mouse hovers the element, as a CSS `:hover` rule
+ * instead of JS hover state, so hovering doesn't re-render anything. Web only:
+ * returns `undefined` on native.
+ *
+ * Two rules keep it working:
+ *
+ * - The base style for the same prop must be an atom, theme atom, or other
+ *   `StyleSheet.create` style. Inline styles beat any CSS rule, so with
+ *   `[{backgroundColor: x}, hover(...)]` the hover never shows.
+ * - Pass the result straight into a style array. It holds class names, not
+ *   style values, so flattening or spreading it breaks the whole style.
+ *
+ * @example
+ * <View style={[t.atoms.bg, hover(t.atoms.bg_contrast_25)]} />
+ */
+export function hover(
+  style: HoverStyle | null | undefined | false,
+): PseudoStyle | undefined {
+  if (!style) return undefined
+
+  const cached = compiledStyles.get(style)
+  if (cached) return cached
+
+  /*
+   * A precompiled style in react-native-web's format: `$$css` marks it as
+   * already compiled, and each string value is a class name. The key only
+   * matters for de-duping, so a later hover() for the same prop wins without
+   * conflicting with the base style's `backgroundColor` etc.
+   */
+  const compiled: Record<string, unknown> = {$$css: true}
+  for (const [prop, value] of Object.entries(style)) {
+    if (value == null) continue
+    if (!SUPPORTED_PROPS.has(prop)) {
+      if (IS_DEV) {
+        console.warn(`ALF: hover() ignored unsupported prop "${prop}"`)
+      }
+      continue
+    }
+    if (
+      !(typeof value === 'string' || typeof value === 'number') ||
+      /[;{}]/.test(String(value))
+    ) {
+      if (IS_DEV) {
+        console.warn(`ALF: hover() ignored invalid value for "${prop}"`)
+      }
+      continue
+    }
+    compiled[`:hover:${prop}`] = getClassName(prop, value)
+  }
+
+  const result = compiled as PseudoStyle
+  compiledStyles.set(style, result)
+  return result
+}
