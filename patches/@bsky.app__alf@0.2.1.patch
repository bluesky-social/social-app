+/**
+ * Registers ALF's style objects with the platform's style system. Only web
+ * does anything (see `index.web.ts`).
+ *
+ * Unlike most platform-split files in ALF, the default here is a no-op rather
+ * than the web implementation, because `@bsky.app/alf/core` loads it outside
+ * of any React Native environment.
+ */
+export function compile<T extends object>(styles: T): T {
+  return styles
+}
