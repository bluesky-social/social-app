+import {type TextStyle, type ViewStyle} from 'react-native'
+
+/**
+ * Props that `hover()` supports. Limited to paint-only props: hovering never
+ * triggers layout, and the CSS for them needs no unit or shorthand handling.
+ */
+export type HoverStyle = Pick<
+  ViewStyle & TextStyle,
+  | 'backgroundColor'
+  | 'borderColor'
+  | 'borderTopColor'
+  | 'borderRightColor'
+  | 'borderBottomColor'
+  | 'borderLeftColor'
+  | 'color'
+  | 'opacity'
+  | 'textDecorationColor'
+  | 'textDecorationLine'
+  | 'textDecorationStyle'
+>
+
+/**
+ * An opaque style returned by `hover()`. Put it in a style array as-is. Its
+ * values are CSS class names rather than style values, so don't read from it,
+ * flatten it, or spread it into another style object.
+ *
+ * Typed as an empty object so it's assignable to any RN style prop.
+ */
+export type PseudoStyle = Readonly<Record<never, never>>
