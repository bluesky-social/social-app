+/*
+ * Text layouts waiting to be taken, a few per key. Each layout is handed out
+ * once, so only one thread uses a text storage at a time. Keys that are never
+ * taken (text that is never drawn, or drawn at another size) are evicted
+ * oldest-first.
+ */
+template <size_t maxKeys_, size_t maxPerKey_>
+class RCTTextLayoutPool {
+ public:
+  void add(const RCTTextLayoutKey &key, RCTTextLayout layout)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto &layouts = layouts_[key];
+    if (layouts.empty()) {
+      order_.push_back(key);
+    }
+    if (layouts.size() >= maxPerKey_) {
+      layouts.erase(layouts.begin());
+    }
+    layouts.push_back(std::move(layout));
+
+    while (order_.size() > maxKeys_) {
+      // A taken key stays in order_, so this can drop a newer layout for the
+      // same text. That text then just takes the default path.
+      layouts_.erase(order_.front());
+      order_.pop_front();
+    }
+  }
+
+  /*
+   * Removes and returns the newest layout for `key` that satisfies `matches`.
+   */
+  NSTextStorage *_Nullable take(const RCTTextLayoutKey &key, const std::function<bool(CGSize)> &matches)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = layouts_.find(key);
+    if (it == layouts_.end()) {
+      return nil;
+    }
+
+    auto &layouts = it->second;
+    for (auto layout = layouts.rbegin(); layout != layouts.rend(); ++layout) {
+      if (matches(layout->size)) {
+        NSTextStorage *textStorage = layout->textStorage;
+        layouts.erase(std::next(layout).base());
+        if (layouts.empty()) {
+          layouts_.erase(it);
+        }
+        return textStorage;
+      }
+    }
+
+    return nil;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::unordered_map<RCTTextLayoutKey, std::vector<RCTTextLayout>, RCTTextLayoutKeyHash> layouts_;
+  std::deque<RCTTextLayoutKey> order_;
+};
