+ *   ("prepared layouts"). That reuses a measured layout when it lays out the
+ *   same way, or lays the text out at exactly the frame size, as the draw
+ *   would.
+ * - The draw takes the prepared layout for its exact size and otherwise lays
+ *   the text out itself, as React Native does by default.
+ */
+namespace {
+
+struct RCTTextLayoutKey {
+  AttributedString attributedString;
+  ParagraphAttributes paragraphAttributes;
+
+  bool operator==(const RCTTextLayoutKey &rhs) const
